# =================================================================
# Portfolio & CMS System Environment Configuration
# =================================================================

# Database Configuration
POSTGRES_DB=portfolio_cms_db
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/portfolio_cms_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Security / JWT (Generate 64+ hex chars secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage
UPLOAD_DIR=/app/uploads

# Mail Notification Service (Optional / Production SMTP)
SPRING_MAIL_HOST=smtp.mailgun.org
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=postmaster@your-domain.com
SPRING_MAIL_PASSWORD=your-smtp-password
APP_MAIL_FROM=no-reply@your-domain.com
APP_MAIL_NOTIFY_TO=admin@your-domain.com

# Frontend & CMS API URLs (for Vite build)
VITE_API_URL=http://localhost:8080
